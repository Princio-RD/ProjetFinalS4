# ============================================================
# CodeIgniter 4
# ============================================================

# Dependencies
/vendor/
/composer.lock
/composer.phar

# Environment
/.env
/.env.*
!.env.example

# Writable directory (logs, cache, uploads, database)
/writable/
!/writable/.htaccess
!/writable/index.html

# Logs CodeIgniter 4
/writable/logs/
*.log
log-*.php

# Cache
/writable/cache/
/writable/debugbar/
/writable/session/

# Uploads
/writable/uploads/

# Database (SQLite)
/writable/*.db
/writable/*.sqlite
/writable/*.sqlite3

# Public assets
/public/assets/

# ============================================================
# IDEs
# ============================================================
/.vscode/
/.idea/
*.swp
*.swo
*~
*.iml
/.project
/.settings/

# ============================================================
# OS
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
*.tmp

# ============================================================
# Logs (généraux)
# ============================================================
*.log
npm-debug.log
yarn-debug.log
yarn-error.log

# ============================================================
# Tests
# ============================================================
/coverage/
/.phpunit.cache
/phpunit.xml
.phpunit.result.cache
.env.testing

# ============================================================
# Backup files
# ============================================================
*.bak
*.backup
*.old
*.orig
